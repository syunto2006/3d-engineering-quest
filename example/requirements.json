{
  "goal": "STLを登録し組立手順を編集して再生する",
  "users": [
    "CAD設計者",
    "組立手順を見る人"
  ],
  "useCases": [
    "STLを複数登録する",
    "部品を選んで位置を変える",
    "組立順を変える",
    "再生する"
  ],
  "acceptance": [
    "3つのSTLを一覧に表示できる",
    "順番変更が再生に反映される",
    "保存JSONを再読込すると設定が戻る"
  ],
  "flow": [
    "開始",
    "STLを選ぶ",
    "形式を検証",
    "成功なら表示",
    "失敗なら理由を表示",
    "部品を編集",
    "保存"
  ],
  "files": {
    "index.html": "画面の構造",
    "style.css": "見た目",
    "app.js": "機能をつなぐ",
    "parts.js": "STLを扱う",
    "sequence.js": "組立手順を計算する"
  },
  "limits": {
    "maxFileMB": 20,
    "maxParts": 30,
    "unit": "mm",
    "localOnly": true
  },
  "assumptions": [
    "STLから部品の役割や正しい組立順は自動確定できない",
    "組立位置と順番は利用者が修正できる"
  ]
}